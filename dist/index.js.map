var pug = require("!../../../node_modules/pug-runtime/index.js");

function template(locals) {var pug_html = "", pug_mixins = {}, pug_interp;var pug_indent = [];
pug_html = pug_html + "\n\u003Cdiv class=\"modal-header\"\u003E\n  \u003Ch5\u003ECommand Execution Result\u003C\u002Fh5\u003E\n  \u003Cdiv class=\"header-actions\"\u003E\n    \u003Cbutton class=\"btn btn-sm btn-outline-secondary me-2\" (click)=\"minimize()\" title=\"Minimize dialog\"\u003E\u003Ci class=\"fas fa-window-minimize\"\u003E\u003C\u002Fi\u003E\u003C\u002Fbutton\u003E\n    \u003Cbutton class=\"btn-close\" (click)=\"cancel()\"\u003E\u003C\u002Fbutton\u003E\n  \u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"modal-body\"\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel\u003ECommand\u003C\u002Flabel\u003E\n    \u003Cpre class=\"form-control command-preview\"\u003E{{command}}\u003C\u002Fpre\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel\u003EResult\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"alert alert-success\" *ngIf=\"exitCode === 0\"\u003E\u003Ci class=\"fas fa-check-circle mr-2\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003ECommand completed successfully\u003C\u002Fspan\u003E\u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"alert alert-danger\" *ngIf=\"exitCode !== 0 &amp;&amp; exitCode !== null\"\u003E\u003Ci class=\"fas fa-exclamation-circle mr-2\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003ECommand failed with exit code {{exitCode}}\u003C\u002Fspan\u003E\u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"alert alert-warning\" *ngIf=\"aborted\"\u003E\u003Ci class=\"fas fa-exclamation-triangle mr-2\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003ECommand execution was aborted\u003C\u002Fspan\u003E\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel\u003EOutput\u003C\u002Flabel\u003E\n    \u003Ctextarea class=\"form-control output-preview\" #outputTextarea readonly rows=\"10\" [ngModel]=\"output\"\u003E\u003C\u002Ftextarea\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\" *ngIf=\"originalInstruction\"\u003E\n    \u003Clabel\u003EOriginal AI Instruction\u003C\u002Flabel\u003E\n    \u003Cpre class=\"form-control instruction-preview\"\u003E{{originalInstruction}}\u003C\u002Fpre\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel style=\"display: {{isRejectMode ? &quot;none&quot; : &quot;block&quot;}}\"\u003EYour Message\u002FInstructions\u003C\u002Flabel\u003E\n    \u003Clabel class=\"text-danger\" style=\"display: {{!isRejectMode ? &quot;none&quot; : &quot;block&quot;}}\"\u003EReason for Rejection\u003C\u002Flabel\u003E\n    \u003Ctextarea class=\"form-control {{isRejectMode ? &quot;border-danger&quot; : &quot;&quot;}}\" #messageTextarea [(ngModel)]=\"userMessage\" rows=\"4\" placeholder=\"{{isRejectMode ? &quot;Enter your reason for rejecting this command...&quot; : &quot;Enter your message or instructions here...&quot;}}\" (keydown)=\"onTextareaKeyDown($event)\"\u003E\u003C\u002Ftextarea\u003E\n  \u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"modal-footer\"\u003E\n  \u003Cbutton class=\"btn btn-secondary\" (click)=\"minimize()\"\u003E\u003Cspan\u003EMinimize\u003C\u002Fspan\u003E\u003Csmall class=\"text-muted\"\u003E(Click outside to close)\u003C\u002Fsmall\u003E\u003C\u002Fbutton\u003E\n  \u003Cbutton class=\"btn btn-secondary\" (click)=\"cancel()\"\u003E\u003Cspan\u003ECancel\u003C\u002Fspan\u003E\u003Csmall class=\"text-muted\"\u003E(Esc)\u003C\u002Fsmall\u003E\u003C\u002Fbutton\u003E\n  \u003Cbutton class=\"btn btn-outline-secondary mr-2\" (click)=\"toggleRejectMode()\" style=\"display: {{isRejectMode ? &quot;inline-block&quot; : &quot;none&quot;}}\"\u003E\u003Cspan\u003ECancel Rejection\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\n  \u003Cbutton class=\"btn btn-danger mr-2\" (click)=\"reject()\"\u003E\u003Cspan style=\"display: {{!isRejectMode ? &quot;inline&quot; : &quot;none&quot;}}\"\u003EReject\u003C\u002Fspan\u003E\u003Cspan style=\"display: {{isRejectMode ? &quot;inline&quot; : &quot;none&quot;}}\"\u003EConfirm Rejection\u003C\u002Fspan\u003E\u003Csmall class=\"text-muted\"\u003E(R)\u003C\u002Fsmall\u003E\u003C\u002Fbutton\u003E\n  \u003Cbutton class=\"btn btn-primary\" (click)=\"accept()\"\u003E\u003Cspan\u003EAccept\u003C\u002Fspan\u003E\u003Csmall class=\"text-muted\"\u003E(Enter)\u003C\u002Fsmall\u003E\u003C\u002Fbutton\u003E\n\u003C\u002Fdiv\u003E";;return pug_html;};
module.exports = template;