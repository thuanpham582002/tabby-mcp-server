var pug = require("!../../../node_modules/pug-runtime/index.js");

function template(locals) {var pug_html = "", pug_mixins = {}, pug_interp;var pug_indent = [];
pug_html = pug_html + "\n\u003Cdiv class=\"modal-header\"\u003E\n  \u003Ch5\u003EConfirm Command Execution\u003C\u002Fh5\u003E\n  \u003Cdiv class=\"header-actions\"\u003E\n    \u003Cbutton class=\"btn btn-sm btn-outline-secondary me-2\" (click)=\"minimize()\" title=\"Minimize dialog\"\u003E\u003Ci class=\"fas fa-window-minimize\"\u003E\u003C\u002Fi\u003E\u003C\u002Fbutton\u003E\n    \u003Cbutton class=\"btn-close\" (click)=\"cancel()\"\u003E\u003C\u002Fbutton\u003E\n  \u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"modal-body\"\u003E\n  \u003Cdiv class=\"alert alert-info\"\u003E\u003Ci class=\"fas fa-info-circle mr-2\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003EThis command will be executed in the terminal.\u003C\u002Fspan\u003E\u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel\u003ETerminal\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"form-control-plaintext\"\u003E{{tabTitle || 'Current terminal'}}\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel\u003ECommand\u003C\u002Flabel\u003E\n    \u003Cpre class=\"form-control command-preview\"\u003E{{command}}\u003C\u002Fpre\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\" *ngIf=\"commandExplanation\"\u003E\n    \u003Clabel\u003ECommand Explanation\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"alert alert-secondary\"\u003E\u003Ci class=\"fas fa-info-circle mr-2\"\u003E\u003C\u002Fi\u003E\n      \u003Cpre class=\"command-explanation\"\u003E{{commandExplanation}}\u003C\u002Fpre\u003E\n    \u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\" *ngIf=\"showRejectInput\"\u003E\n    \u003Clabel\u003EReason for Rejection\u003C\u002Flabel\u003E\n    \u003Ctextarea class=\"form-control\" #rejectMessageTextarea [(ngModel)]=\"rejectMessage\" rows=\"3\" placeholder=\"Enter your reason for rejecting this command...\" (keydown)=\"onTextareaKeyDown($event)\"\u003E\u003C\u002Ftextarea\u003E\n  \u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003Cdiv class=\"modal-footer\"\u003E\n  \u003Cbutton class=\"btn btn-secondary\" (click)=\"minimize()\"\u003E\u003Cspan\u003EMinimize\u003C\u002Fspan\u003E\u003Csmall class=\"text-muted\"\u003E(Click outside to close)\u003C\u002Fsmall\u003E\u003C\u002Fbutton\u003E\n  \u003Cbutton class=\"btn btn-danger mr-2\" *ngIf=\"!showRejectInput\" (click)=\"showRejectForm()\"\u003E\u003Cspan\u003EReject\u003C\u002Fspan\u003E\u003Csmall class=\"text-muted\"\u003E(R)\u003C\u002Fsmall\u003E\u003C\u002Fbutton\u003E\n  \u003Cbutton class=\"btn btn-danger mr-2\" *ngIf=\"showRejectInput\" (click)=\"reject()\"\u003E\u003Cspan\u003EConfirm Rejection\u003C\u002Fspan\u003E\u003Csmall class=\"text-muted\"\u003E(Enter)\u003C\u002Fsmall\u003E\u003C\u002Fbutton\u003E\n  \u003Cbutton class=\"btn btn-primary\" *ngIf=\"!showRejectInput\" (click)=\"confirm()\"\u003E\u003Cspan\u003EExecute\u003C\u002Fspan\u003E\u003Csmall class=\"text-muted\"\u003E(Enter)\u003C\u002Fsmall\u003E\u003C\u002Fbutton\u003E\n\u003C\u002Fdiv\u003E";;return pug_html;};
