var pug = require("!../../../node_modules/pug-runtime/index.js");

function template(locals) {var pug_html = "", pug_mixins = {}, pug_interp;var pug_indent = [];
pug_html = pug_html + "\n\u003Cdiv class=\"content\"\u003E\n  \u003Cdiv class=\"form-line\"\u003E\n    \u003Cdiv class=\"header\"\u003E\n      \u003Cdiv class=\"title\"\u003EMCP Settings\u003C\u002Fdiv\u003E\n      \u003Cdiv class=\"description\"\u003EConfigure settings for the MCP (Model Control Protocol) integration\u003C\u002Fdiv\u003E\n    \u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel\u003EServer URL\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"d-flex\"\u003E\n      \u003Cinput class=\"form-control mr-2\" type=\"text\" [(ngModel)]=\"serverUrl\"\u003E\n      \u003Cbutton class=\"btn btn-secondary\" (click)=\"saveServerUrl()\"\u003E\u003Ci class=\"fas fa-save mr-1\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003ESave\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"text-muted\"\u003EThe URL of the MCP server to connect to\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel\u003EPort\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"d-flex\"\u003E\n      \u003Cinput class=\"form-control mr-2\" type=\"number\" [(ngModel)]=\"port\"\u003E\n      \u003Cbutton class=\"btn btn-secondary\" (click)=\"savePort()\"\u003E\u003Ci class=\"fas fa-save mr-1\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003ESave\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"text-muted\"\u003EThe port number for the MCP server\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel\u003EStart on Boot\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"d-flex\"\u003E\n      \u003Ctoggle [(ngModel)]=\"startOnBoot\"\u003E\u003C\u002Ftoggle\u003E\n      \u003Cbutton class=\"btn btn-secondary ml-2\" (click)=\"toggleStartOnBoot()\"\u003E\u003Ci class=\"fas fa-save mr-1\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003ESave\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"text-muted\"\u003EAutomatically start the MCP server when Tabby starts\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel\u003EServer Control\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"d-flex\"\u003E\n      \u003Cbutton class=\"btn btn-primary mr-2\" *ngIf=\"!isServerRunning\" (click)=\"startServer()\"\u003E\u003Ci class=\"fas fa-play mr-2\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003EStart Server\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\n      \u003Cbutton class=\"btn btn-danger\" *ngIf=\"isServerRunning\" (click)=\"stopServer()\"\u003E\u003Ci class=\"fas fa-stop mr-2\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003EStop Server\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"text-muted mt-2\" *ngIf=\"isServerRunning\"\u003EServer is currently running\u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"text-muted mt-2\" *ngIf=\"!isServerRunning\"\u003EServer is currently stopped\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel\u003EDebug Logging\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"d-flex\"\u003E\n      \u003Ctoggle [(ngModel)]=\"enableDebugLogging\"\u003E\u003C\u002Ftoggle\u003E\n      \u003Cbutton class=\"btn btn-secondary ml-2\" (click)=\"toggleDebugLogging()\"\u003E\u003Ci class=\"fas fa-save mr-1\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003ESave\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"text-muted\"\u003EEnable detailed logging for MCP operations\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Ch3 class=\"mt-4\"\u003EPair Programming Mode\u003C\u002Fh3\u003E\n  \u003Cdiv class=\"form-group\"\u003E\n    \u003Clabel\u003EEnable Pair Programming Mode\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"d-flex\"\u003E\n      \u003Ctoggle [(ngModel)]=\"pairProgrammingEnabled\"\u003E\u003C\u002Ftoggle\u003E\n      \u003Cbutton class=\"btn btn-secondary ml-2\" (click)=\"togglePairProgrammingMode()\"\u003E\u003Ci class=\"fas fa-save mr-1\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003ESave\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"text-muted\"\u003EEnable collaborative features for pair programming with AI\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\" *ngIf=\"pairProgrammingEnabled\"\u003E\n    \u003Clabel\u003EAuto Focus Terminal\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"d-flex\"\u003E\n      \u003Ctoggle [(ngModel)]=\"autoFocusTerminal\"\u003E\u003C\u002Ftoggle\u003E\n      \u003Cbutton class=\"btn btn-secondary ml-2\" (click)=\"toggleAutoFocusTerminal()\"\u003E\u003Ci class=\"fas fa-save mr-1\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003ESave\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"text-muted\"\u003EAutomatically focus the terminal window when executing commands\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\" *ngIf=\"pairProgrammingEnabled\"\u003E\n    \u003Clabel\u003EShow Confirmation Dialog\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"d-flex\"\u003E\n      \u003Ctoggle [(ngModel)]=\"showConfirmationDialog\"\u003E\u003C\u002Ftoggle\u003E\n      \u003Cbutton class=\"btn btn-secondary ml-2\" (click)=\"toggleShowConfirmationDialog()\"\u003E\u003Ci class=\"fas fa-save mr-1\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003ESave\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"text-muted\"\u003EShow a confirmation dialog before executing commands\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n  \u003Cdiv class=\"form-group\" *ngIf=\"pairProgrammingEnabled\"\u003E\n    \u003Clabel\u003EShow Result Dialog\u003C\u002Flabel\u003E\n    \u003Cdiv class=\"d-flex\"\u003E\n      \u003Ctoggle [(ngModel)]=\"showResultDialog\"\u003E\u003C\u002Ftoggle\u003E\n      \u003Cbutton class=\"btn btn-secondary ml-2\" (click)=\"toggleShowResultDialog()\"\u003E\u003Ci class=\"fas fa-save mr-1\"\u003E\u003C\u002Fi\u003E\u003Cspan\u003ESave\u003C\u002Fspan\u003E\u003C\u002Fbutton\u003E\n    \u003C\u002Fdiv\u003E\n    \u003Cdiv class=\"text-muted\"\u003EShow a dialog with command results after execution\u003C\u002Fdiv\u003E\n  \u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E";;return pug_html;};
module.exports = template;