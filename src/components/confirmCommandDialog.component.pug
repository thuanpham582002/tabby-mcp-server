.modal-header
  h5 Confirm Command Execution
  .header-actions
    button.btn.btn-sm.btn-outline-secondary.me-2((click)='minimize()', title='Minimize dialog')
      i.fas.fa-window-minimize
    button.btn-close((click)='cancel()')

.modal-body
  .alert.alert-info
    i.fas.fa-info-circle.mr-2
    span This command will be executed in the terminal.

  .form-group
    label Terminal
    .form-control-plaintext {{tabTitle || 'Current terminal'}}

  .form-group
    label Command
    pre.form-control.command-preview {{command}}

  .form-group(*ngIf='commandExplanation')
    label Command Explanation
    .alert.alert-secondary
      i.fas.fa-info-circle.mr-2
      pre.command-explanation {{commandExplanation}}

  .form-group(*ngIf='showRetypeInput && !showRejectInput')
    label Retype to Confirm
    .alert.alert-warning.mb-2
      i.fas.fa-keyboard.mr-2
      span Type the following to confirm:

      // Character-by-character highlighting display
      .character-highlighting.mt-2(*ngIf='getCharacterHighlighting().length > 0')
        span.character(
          *ngFor='let charData of getCharacterHighlighting()',
          [class.char-correct]='charData.state === "correct"',
          [class.char-incorrect]='charData.state === "incorrect"',
          [class.char-pending]='charData.state === "pending"'
        ) {{charData.char === ' ' ? '␣' : charData.char}}

      // Fallback display when highlighting is disabled
      code(*ngIf='getCharacterHighlighting().length === 0') {{getRetypeTarget()}}

      span.ml-2(*ngIf='retypeAttempts > 0')
        small.text-muted (Attempt {{retypeAttempts + 1}})

    input.form-control(
      #retypeInput
      [(ngModel)]='retypeValue',
      [class.is-valid]='retypeValid && retypeValue.length > 0',
      [class.is-invalid]='!retypeValid && retypeValue.length > 0',
      placeholder='Start typing...',
      (input)='onRetypeInput()',
      (focus)='onRetypeFocus()',
      (blur)='onRetypeBlur()',
      autocomplete='off',
      spellcheck='false'
    )

    // Enhanced progress indicators
    .typing-metrics.mt-2(*ngIf='shouldShowTypingMetrics() && retypeValue.length > 0')
      .row
        .col-md-8
          // Main progress bar
          .progress
            .progress-bar(
              [style.width.%]='partialMatchScore',
              [class.bg-success]='partialMatchScore > 80',
              [class.bg-warning]='partialMatchScore > 40 && partialMatchScore <= 80',
              [class.bg-danger]='partialMatchScore <= 40'
            )
              span {{partialMatchScore}}% match

        .col-md-4(*ngIf='shouldShowTypingSpeed()')
          // Typing speed indicator
          .typing-speed.text-center
            small.text-muted Typing Speed
            .badge.badge-info {{getTypingSpeedText()}}

      // Character-level progress
      .character-progress.mt-2(*ngIf='retypeTarget.length > 0')
        small.text-muted
          | Progress: {{retypeValue.length}}/{{retypeTarget.length}} characters
          span(*ngIf='characterStates.length > 0')
            |  ({{getCorrectCharacterCount()}} correct, {{getIncorrectCharacterCount()}} incorrect)

    // Helpful hints
    .alert.alert-info.mt-2(*ngIf='retypeHints.length > 0 && !retypeValid')
      i.fas.fa-lightbulb.mr-2
      span(*ngFor='let hint of retypeHints; let last = last')
        | {{hint}}
        br(*ngIf='!last')

    // Validation feedback
    .invalid-feedback(*ngIf='!retypeValid && retypeValue.length > 0')
      | Text does not match. Please type exactly: {{getRetypeTarget()}}

    .valid-feedback(*ngIf='retypeValid')
      | Perfect! You can now execute the command.

    // Tab auto-completion hint
    .alert.alert-success.mt-2(*ngIf='getAutoCompletionHint() && !shouldShowDoubleEnterHint()')
      i.fas.fa-magic.mr-2
      span {{getAutoCompletionHint()}}

    // Double Enter bypass hint
    .alert.alert-info.mt-2(*ngIf='shouldShowDoubleEnterHint()')
      i.fas.fa-keyboard.mr-2
      span Press Enter again within 2 seconds to bypass validation
      .progress.mt-1
        .progress-bar.progress-bar-striped.progress-bar-animated(style='width: 100%')

    // Bypass option (shown after failed attempts)
    .alert.alert-secondary.mt-3(*ngIf='showBypassOption')
      .d-flex.justify-content-between.align-items-center
        div
          i.fas.fa-exclamation-triangle.mr-2
          span Having trouble? You can skip the retype validation.
        button.btn.btn-outline-warning.btn-sm((click)='executeWithBypass()')
          span(*ngIf='!bypassRequested') Skip This Time
          span(*ngIf='bypassRequested')
            i.fas.fa-exclamation-triangle.mr-1
            | Confirm Skip

  .form-group(*ngIf='showRejectInput')
    label Reason for Rejection
    textarea.form-control(
      #rejectMessageTextarea
      [(ngModel)]='rejectMessage',
      rows='3',
      placeholder='Enter your reason for rejecting this command...',
      (keydown)='onTextareaKeyDown($event)'
    )

.modal-footer
  button.btn.btn-secondary((click)='minimize()')
    span Minimize
    small.text-muted (Click outside to close)

  button.btn.btn-danger.mr-2(*ngIf='!showRejectInput', (click)='showRejectForm()')
    span Reject
    small.text-muted (R)

  button.btn.btn-danger.mr-2(*ngIf='showRejectInput', (click)='reject()')
    span Confirm Rejection
    small.text-muted (Enter)

  button.btn.btn-primary(*ngIf='!showRejectInput && canExecuteCommand()', (click)='confirm()')
    span Execute
    small.text-muted (Enter)

  button.btn.btn-primary(*ngIf='!showRejectInput && !canExecuteCommand() && !showBypassOption', disabled)
    span Execute
    small.text-muted (Complete retype first)

  button.btn.btn-warning(*ngIf='!showRejectInput && !canExecuteCommand() && showBypassOption && !bypassRequested', (click)='executeWithBypass()')
    i.fas.fa-exclamation-triangle.mr-1
    span Execute Anyway
    small.text-muted (Skip validation)

  button.btn.btn-danger(*ngIf='!showRejectInput && !canExecuteCommand() && showBypassOption && bypassRequested', (click)='executeWithBypass()')
    i.fas.fa-exclamation-triangle.mr-1
    span Confirm Execute
    small.text-muted (Bypass confirmed)
