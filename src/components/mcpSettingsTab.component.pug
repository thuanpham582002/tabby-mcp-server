.content
  .form-line
    .header
      .title MCP Settings
      .description Configure settings for the MCP (Model Control Protocol) integration

  .form-group
    label Server URL
    .d-flex
      input.form-control.mr-2(
        type='text',
        [(ngModel)]='serverUrl',
      )
      button.btn.btn-secondary(
        (click)='saveServerUrl()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted The URL of the MCP server to connect to

  .form-group
    label Port
    .d-flex
      input.form-control.mr-2(
        type='number',
        [(ngModel)]='port',
      )
      button.btn.btn-secondary(
        (click)='savePort()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted The port number for the MCP server

  .form-group
    label Start on Boot
    .d-flex
      toggle(
        [(ngModel)]='startOnBoot',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleStartOnBoot()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Automatically start the MCP server when Tabby starts

  .form-group
    label Server Control
    .d-flex
      button.btn.btn-primary.mr-2(
        *ngIf='!isServerRunning',
        (click)='startServer()',
      )
        i.fas.fa-play.mr-2
        span Start Server
      button.btn.btn-danger(
        *ngIf='isServerRunning',
        (click)='stopServer()',
      )
        i.fas.fa-stop.mr-2
        span Stop Server
    .text-muted.mt-2(*ngIf='isServerRunning') Server is currently running
    .text-muted.mt-2(*ngIf='!isServerRunning') Server is currently stopped

  .form-group
    label Debug Logging
    .d-flex
      toggle(
        [(ngModel)]='enableDebugLogging',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleDebugLogging()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Enable detailed logging for MCP operations

  h3.mt-4 Pair Programming Mode

  .form-group
    label Enable Pair Programming Mode
    .d-flex
      toggle(
        [(ngModel)]='pairProgrammingEnabled',
      )
      button.btn.btn-secondary.ml-2(
        (click)='togglePairProgrammingMode()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Enable collaborative features for pair programming with AI

  .form-group(*ngIf='pairProgrammingEnabled')
    label Auto Focus Terminal
    .d-flex
      toggle(
        [(ngModel)]='autoFocusTerminal',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleAutoFocusTerminal()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Automatically focus the terminal window when executing commands

  .form-group(*ngIf='pairProgrammingEnabled')
    label Show Confirmation Dialog
    .d-flex
      toggle(
        [(ngModel)]='showConfirmationDialog',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleShowConfirmationDialog()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Show a confirmation dialog before executing commands

  .form-group(*ngIf='pairProgrammingEnabled')
    label Show Result Dialog
    .d-flex
      toggle(
        [(ngModel)]='showResultDialog',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleShowResultDialog()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Show a dialog with command results after execution

  h4.mt-4(*ngIf='pairProgrammingEnabled && showConfirmationDialog') Retype Functionality

  .form-group(*ngIf='pairProgrammingEnabled && showConfirmationDialog')
    label Require Retype
    .d-flex
      toggle(
        [(ngModel)]='requireRetype',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleRequireRetype()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Require typing part of the command to confirm execution (muscle memory training)

  .form-group(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype')
    label Retype Mode
    .d-flex
      select.form-control.mr-2(
        [(ngModel)]='retypeMode',
        (change)='updateRetypeMode()'
      )
        option(value='partial') Partial - Type first N characters
        option(value='full') Full - Type entire command
        option(value='keywords') Keywords - Type key command parts
      button.btn.btn-secondary(
        (click)='updateRetypeMode()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Choose how much of the command needs to be retyped

  .form-group(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype && retypeMode === "partial"')
    label Retype Threshold (Characters)
    .d-flex
      input.form-control.mr-2(
        type='number',
        [(ngModel)]='retypeThreshold',
        min='1',
        max='100',
        (change)='updateRetypeThreshold()'
      )
      button.btn.btn-secondary(
        (click)='updateRetypeThreshold()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Number of characters to type when using partial mode

  h5.mt-4(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype') Bypass Options

  .form-group(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype')
    label Allow Retype Bypass
    .d-flex
      toggle(
        [(ngModel)]='allowRetypeBypass',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleAllowRetypeBypass()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Allow users to bypass retype validation after failed attempts

  .form-group(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype && allowRetypeBypass')
    label Bypass After Attempts
    .d-flex
      input.form-control.mr-2(
        type='number',
        [(ngModel)]='bypassAfterAttempts',
        min='1',
        max='10',
        (change)='updateBypassAfterAttempts()'
      )
      button.btn.btn-secondary(
        (click)='updateBypassAfterAttempts()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Number of failed attempts before showing bypass option

  .form-group(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype && allowRetypeBypass')
    label Bypass Requires Confirmation
    .d-flex
      toggle(
        [(ngModel)]='bypassRequiresConfirmation',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleBypassRequiresConfirmation()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Require additional confirmation when bypassing retype validation

  h5.mt-4(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype') Visual Enhancements

  .form-group(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype')
    label Character-by-Character Highlighting
    .d-flex
      toggle(
        [(ngModel)]='enableCharacterHighlighting',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleEnableCharacterHighlighting()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Highlight correct characters in green and incorrect in red as you type

  .form-group(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype')
    label Case Insensitive Matching
    .d-flex
      toggle(
        [(ngModel)]='caseInsensitiveMatching',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleCaseInsensitiveMatching()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Allow uppercase/lowercase variations (e.g., 'Git' matches 'git')

  .form-group(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype')
    label Show Typing Metrics
    .d-flex
      toggle(
        [(ngModel)]='showTypingMetrics',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleShowTypingMetrics()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Display detailed progress indicators and character-level feedback

  .form-group(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype')
    label Enable Typing Speed Tracking
    .d-flex
      toggle(
        [(ngModel)]='enableTypingSpeed',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleEnableTypingSpeed()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Track and display typing speed (characters per minute)

  .form-group(*ngIf='pairProgrammingEnabled && showConfirmationDialog && requireRetype')
    label Enable Tab Auto-Completion
    .d-flex
      toggle(
        [(ngModel)]='enableTabAutoCompletion',
      )
      button.btn.btn-secondary.ml-2(
        (click)='toggleEnableTabAutoCompletion()',
      )
        i.fas.fa-save.mr-1
        span Save
    .text-muted Allow Tab key to auto-complete commands while maintaining muscle memory training
